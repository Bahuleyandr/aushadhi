  "rule": {
    "rule_id": "warfarin__metronidazole",
    "draft_rule_sha256": "2f6e13a141107149c32c82df764a0710a423265e5600b35155ece4d53222df3f",
    "severity": "major",
    "mechanism": "Metronidazole can potentiate warfarin anticoagulant effect and prolong prothrombin time; the current warfarin label also lists metronidazole as a CYP2C9 inhibitor.",
    "management": {
      "dispense_action": "confirm_and_monitor",
      "action_target": null,
      "do_not_interrupt": [
        "warfarin",
        "metronidazole"
      ],
      "prescriber_action": "Confirm that the prescriber or anticoagulation service has reviewed the warfarin dose and arranged PT/INR monitoring when oral metronidazole is started or stopped. Do not independently stop either medicine or autonomously change the warfarin dose.",
      "monitoring": "Use prescriber-directed PT/INR monitoring during coadministration and when the interacting medicine is started or stopped.",
      "patient_counselling": "Counsel the patient to seek urgent clinical advice for unusual bleeding or bruising, prolonged bleeding, blood in urine, or red or tarry-black stools.",
      "timing": null,
      "duration": null,
      "exceptions": "This review scope is limited to exact oral-tablet product assertions. Tinidazole, topical metronidazole, and metronidazole combination suspensions are outside the proposed scope."
    }
  },
