  "rule": {
    "rule_id": "warfarin__amiodarone",
    "draft_rule_sha256": "da731112748d90f672439d290b079f7ee2a90bb00c8b05c67110ec12509f485d",
    "severity": "major",
    "mechanism": "Amiodarone potentiates warfarin's anticoagulant response, increasing PT/INR and the risk of serious or fatal bleeding.",
    "management": {
      "dispense_action": "confirm_and_monitor",
      "action_target": null,
      "do_not_interrupt": [
        "warfarin",
        "amiodarone"
      ],
      "prescriber_action": "Confirm that the prescriber or anticoagulation service has reviewed the warfarin dose and arranged PT/INR monitoring when amiodarone is started, stopped, or changed. Do not independently stop either established medicine or autonomously change the warfarin dose.",
      "monitoring": "Use prescriber-directed PT/INR monitoring during coadministration and after amiodarone discontinuation.",
      "patient_counselling": "Counsel the patient to seek urgent clinical advice for unusual bleeding or bruising, prolonged bleeding, blood in urine, or red or tarry-black stools.",
      "timing": null,
      "duration": "The interaction can persist for weeks to months after amiodarone discontinuation.",
      "exceptions": "The U.S. amiodarone label's numerical warfarin dose-reduction instruction is evidence only and is not an autonomous pharmacy action."
    }
  },
