[Unit]
Description=aushadhi post-build export snapshot
After=aushadhi-build.service

[Service]
Type=oneshot
User=aushadhi
Group=aushadhi
WorkingDirectory=/opt/aushadhi
Environment=HOME=/var/cache/aushadhi/export
Environment=XDG_CACHE_HOME=/var/cache/aushadhi/export
ExecStart=/usr/local/libexec/aushadhi-export-snapshot
StandardOutput=append:/var/log/aushadhi/export/export.log
StandardError=append:/var/log/aushadhi/export/export.log
Nice=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
StateDirectory=aushadhi-export
StateDirectoryMode=0750
LogsDirectory=aushadhi/export
LogsDirectoryMode=0750
CacheDirectory=aushadhi/export
CacheDirectoryMode=0750
ReadOnlyPaths=/opt/aushadhi /var/lib/aushadhi
ReadWritePaths=/var/log/aushadhi/export /var/cache/aushadhi/export /var/lib/aushadhi-export
InaccessiblePaths=/root
MemoryHigh=4G
MemoryMax=5G
