[Unit]
Description=aushadhi PharmEasy crawler (polite, single-instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/aushadhi
Environment=AUSHADHI_PHARMEASY_CAP=20000
ExecStart=/usr/bin/bash /root/aushadhi/scripts/pharmeasy-loop.sh
Restart=always
RestartSec=30
StandardOutput=append:/root/aushadhi/logs/pharmeasy.log
StandardError=append:/root/aushadhi/logs/pharmeasy.log

[Install]
WantedBy=multi-user.target
