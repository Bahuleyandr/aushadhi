[Unit]
Description=Aushadhi raw page-cache compression
After=local-fs.target
ConditionPathIsDirectory=/var/lib/aushadhi/data/raw

[Service]
Type=oneshot
User=aushadhi
Group=aushadhi
WorkingDirectory=/opt/aushadhi
Environment=HOME=/var/cache/aushadhi/retention
Environment=XDG_CACHE_HOME=/var/cache/aushadhi/retention
Environment=AUSHADHI_RAW_ROOT=/var/lib/aushadhi/data/raw
Environment=AUSHADHI_CACHE_MIN_AGE_MINUTES=360
Environment=AUSHADHI_CACHE_COMPRESS_JOBS=4
Environment=AUSHADHI_CACHE_COMPRESS_BATCH_SIZE=64
ExecStart=/usr/bin/bash /opt/aushadhi/scripts/compress-page-cache.sh
Nice=15
IOSchedulingClass=idle
CPUWeight=20
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
StateDirectory=aushadhi/data/raw
StateDirectoryMode=0750
CacheDirectory=aushadhi/retention
CacheDirectoryMode=0750
ReadOnlyPaths=/opt/aushadhi
ReadWritePaths=/var/lib/aushadhi/data/raw /var/cache/aushadhi/retention
InaccessiblePaths=/root
MemoryMax=1G
