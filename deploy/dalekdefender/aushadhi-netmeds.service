[Unit]
Description=aushadhi Netmeds crawler (polite, single-instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/aushadhi
Environment=AUSHADHI_NETMEDS_CAP=20000
ExecStart=/usr/bin/bash /root/aushadhi/scripts/netmeds-loop.sh
Restart=always
RestartSec=30
StandardOutput=append:/root/aushadhi/logs/netmeds.log
StandardError=append:/root/aushadhi/logs/netmeds.log

[Install]
WantedBy=multi-user.target
