[Unit]
Description=aushadhi exhaustive 1mg crawler (polite, single-instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aushadhi
Group=aushadhi
WorkingDirectory=/opt/aushadhi
Environment=HOME=/var/cache/aushadhi/onemg
Environment=XDG_CACHE_HOME=/var/cache/aushadhi/onemg
Environment=AUSHADHI_RAW_ROOT=/var/lib/aushadhi/data/raw
Environment=AUSHADHI_DIST_ROOT=/var/lib/aushadhi/dist
Environment=AUSHADHI_DAILY_CAP=20000
Environment=NODE_OPTIONS=--max-old-space-size=6144
ExecStartPre=+/usr/local/libexec/aushadhi-network-hook aushadhi-crawl.service start
ExecStart=/usr/bin/bash /opt/aushadhi/scripts/crawl-loop.sh
ExecStopPost=+/usr/local/libexec/aushadhi-network-hook aushadhi-crawl.service stop
Restart=always
RestartSec=30
StandardOutput=append:/var/log/aushadhi/onemg/crawl.log
StandardError=append:/var/log/aushadhi/onemg/crawl.log
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StateDirectory=aushadhi/data/raw/onemg
StateDirectoryMode=0750
LogsDirectory=aushadhi/onemg
LogsDirectoryMode=0750
CacheDirectory=aushadhi/onemg
CacheDirectoryMode=0750
ReadOnlyPaths=/opt/aushadhi /var/lib/aushadhi/dist /var/lib/aushadhi/data/raw
ReadWritePaths=/var/lib/aushadhi/data/raw/onemg /var/log/aushadhi/onemg /var/cache/aushadhi/onemg
InaccessiblePaths=/root
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
