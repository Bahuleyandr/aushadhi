[Unit]
Description=Aushadhi unindexed source-cohort generation retention
After=local-fs.target
ConditionPathIsDirectory=/var/lib/aushadhi/dist/.generations
ConditionPathExists=/var/lib/aushadhi/dist/cohort-index.json

[Service]
Type=oneshot
User=aushadhi
Group=aushadhi
Environment=AUSHADHI_DIST_ROOT=/var/lib/aushadhi/dist
Environment=AUSHADHI_SOURCE_GENERATION_RETENTION_LOCK=/var/cache/aushadhi/source-generation-retention/retention.lock
Environment=AUSHADHI_SOURCE_GENERATION_RETENTION_AUTHORITY_FILE=/etc/aushadhi/source-generation-retention-apply.conf
Environment=AUSHADHI_SOURCE_GENERATION_RETENTION_KEEP=14
Environment=AUSHADHI_SOURCE_GENERATION_RETENTION_APPLY=0
EnvironmentFile=-/etc/aushadhi/source-generation-retention-apply.conf
ExecStart=/usr/local/libexec/aushadhi-source-generation-retention
UMask=0027
Nice=15
IOSchedulingClass=idle
CPUWeight=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
StateDirectory=aushadhi/dist
StateDirectoryMode=0750
CacheDirectory=aushadhi/source-generation-retention
CacheDirectoryMode=0750
ReadOnlyPaths=/opt/aushadhi
ReadWritePaths=/var/lib/aushadhi/dist /var/cache/aushadhi/source-generation-retention
InaccessiblePaths=/root /var/lib/aushadhi/data /var/lib/aushadhi-export
MemoryMax=512M
