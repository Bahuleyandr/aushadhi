[Unit]
Description=Aushadhi verified export snapshot retention
After=aushadhi-export.service
ConditionPathIsDirectory=/var/lib/aushadhi-export

[Service]
Type=oneshot
User=aushadhi
Group=aushadhi
Environment=AUSHADHI_EXPORT_ROOT=/var/lib/aushadhi-export
Environment=AUSHADHI_EXPORT_RETENTION_KEEP=14
Environment=AUSHADHI_EXPORT_RETENTION_APPLY=0
ExecStart=/usr/local/libexec/aushadhi-export-retention
UMask=0027
Nice=15
IOSchedulingClass=idle
CPUWeight=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/aushadhi
ReadWritePaths=/var/lib/aushadhi-export
InaccessiblePaths=/root /var/lib/aushadhi/dist /var/lib/aushadhi/data/restricted/cdci
MemoryMax=256M
